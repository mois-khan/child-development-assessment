# Copy to .env.local and fill in once you have a Supabase project.
#
# Until these are set, the app runs entirely on localStorage (parent side)
# and a local dev-mode admin session — see lib/supabase/env.ts. Nothing here
# is required to develop or demo the app.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Never exposed to the browser. Needed for admin writes and any
# server action that must bypass RLS (e.g. publishing a content version).
SUPABASE_SERVICE_ROLE_KEY=
